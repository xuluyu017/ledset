	<Project>
		<Option title="byle320_kws" />
		<Option compiler="pi32v2_r1_large_lto_compiler" />
		<Build>
			<Target title="Release">
				<Option output="apps/app/post_build/uc04/sdk.elf" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="pi32v2_r1_large_lto_compiler" />
				<Compiler>
					<Add option="-flto" />
					<Add option="-Wundef" />
					<Add option="-g" />
					<Add option="-Wuninitialized" />
					<Add option="-Wno-invalid-noreturn" />
					<Add option="-fno-common" />
					<Add option="-integrated-as" />
					<Add option="-Oz" />
					<Add option="-fallow-pointer-null" />
					<Add option="-fprefer-gnu-section" />
					<Add option="-Wno-shift-negative-value" />
					<Add option="-mllvm -pi32v2-large-program=true" />
					<Add option="-Werror=implicit-function-declaration" />
					<Add option="-Werror=return-type" />
					<Add option="-Werror=undef" />
					<Add option="-Wno-format" />
					<Add option="-D__FPGA=0" />
					<Add option="-DCONFIG_CPU_UC04=1" />
					<Add option="-DD_MASKROM_CODE=0" />
					<Add option="-DD_IS_FLASH_SYSTEM" />
					<Add option="-DFPGA=0" />
					<Add option="-DHAS_SRC_EN=0" />
