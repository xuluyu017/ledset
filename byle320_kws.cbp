					<Add option="apps/user/ir_emitter/lib_irA.a" />
					<Add option="--end-group" />
					<Add option="-Tapps/app/post_build/uc04/app.ld" />
					<Add option="-M=apps/app/post_build/uc04/app.map" />
					<Add library="C:/JL/pi32/pi32v2-lib/r1-large/libm.a" />
				</Linker>
				<ExtraCommands>
					<Add before="apps\user\Byle_build_pre.bat" />
					<Add before="$compiler $options $includes -D__LD__ -E -P apps\app\post_build\uc04\app_ld.c -o apps\app\post_build\uc04\app.ld" />
					<Add before="$compiler $options $includes -D__LD__ -E -P apps\app\post_build\uc04\download_bat.c -o apps\app\post_build\uc04\download.bat" />
					<Add before="tools\utils\fixbat.exe apps\app\post_build\uc04\download.bat" />
					<Add before="$compiler $options $includes -D__LD__ -E -P apps\app\post_build\uc04\download_sh.c -o apps\app\post_build\uc04\download.sh" />
					<Add before="$compiler $options $includes -D__LD__ -E -P apps\app\post_build\uc04\isd_config_ini.c -o apps\app\post_build\uc04\isd_config.ini" />
					<Add after="apps\app\post_build\uc04\download.bat sdk" />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
